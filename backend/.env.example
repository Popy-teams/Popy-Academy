# Database
DATABASE_URL=postgresql://popy:popy@localhost:5432/popy_academy?schema=public

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-32chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
MFA_ISSUER=Popy Academy

# App
PORT=5001
APP_ORIGIN=http://localhost:8443
NODE_ENV=development

# Retention (days)
RETENTION_AUDIT_DAYS=365
RETENTION_SYNC_DAYS=90
RETENTION_ROBOT_EVENTS_DAYS=180

# Billing: demo (no card) | stripe (requires STRIPE_SECRET_KEY)
BILLING_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# MFA obligatoire pour ces rôles (virgules)
MFA_REQUIRED_ROLES=TEACHER,ADMIN

# Seed au démarrage Docker (false en production)
RUN_SEED=true
